<?xml version="1.0" encoding="UTF-8"?>
<!-- Sve sto se dogadja ide u konzolu (i u logs/nottrilix-2026.log). %clr = Spring Boot ANSI boje. -->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <charset>UTF-8</charset>
      <pattern>%clr(%d{HH:mm:ss.SSS}){faint} %clr(%5p) %clr(%-14.14thread){magenta} %clr(%-28.28logger{28}){cyan} %clr(:){faint} %m%n%wEx</pattern>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>logs/nottrilix-2026.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>logs/nottrilix-2026.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>7</maxHistory>
    </rollingPolicy>
    <encoder>
      <charset>UTF-8</charset>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%thread] %logger{40} : %m%n%wEx</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
  <logger name="com.nottrilix" level="DEBUG"/>
</configuration>
